generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  income
  expense
  transfer
}

enum CategoryType {
  income
  expense
}

enum ConversationAction {
  income
  expense
  transfer
  wallet
  category_income
  category_expense
  attachment
}

enum ConversationStep {
  transaction_wallet
  transaction_category
  transaction_amount
  transaction_description
  transaction_details
  transfer_source_wallet
  transfer_destination_wallet
  transfer_details
  transfer_description
  wallet_name
  wallet_select_rename
  wallet_new_name
  wallet_select_delete
  wallet_delete_confirm
  category_name
  attachment_transaction
  attachment_upload
  receipt_upload
}

model User {
  id               String        @id @default(uuid())
  telegramId       BigInt        @unique
  telegramUsername String?       @db.VarChar(100)
  firstName        String?       @db.VarChar(100)
  lastName         String?       @db.VarChar(100)
  languageCode     String?       @db.VarChar(10)
  isActive         Boolean       @default(true)
  timezone         String        @default("Asia/Jakarta")
  currency         String        @default("IDR") @db.Char(3)
  wallets          Wallet[]
  categories       Category[]
  transactions     Transaction[]
  conversation     Conversation?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("users")
}

model Wallet {
  id                   String        @id @default(uuid())
  userId               String
  name                 String        @db.VarChar(100)
  icon                 String?       @db.VarChar(50)
  color                String?       @db.VarChar(20)
  currency             String        @default("IDR") @db.Char(3)
  isDefault            Boolean       @default(false)
  isActive             Boolean       @default(true)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[] @relation("TransactionWallet")
  incomingTransactions Transaction[] @relation("TransferDestinationWallet")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("wallets")
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  type         CategoryType
  name         String        @db.VarChar(100)
  icon         String?       @db.VarChar(50)
  color        String?       @db.VarChar(20)
  isDefault    Boolean       @default(false)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, type, name])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String
  walletId         String
  transferWalletId String?
  categoryId       String?
  type             TransactionType
  amount           Decimal         @db.Decimal(18, 2)
  description      String          @db.Text
  transactionDate  DateTime
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           Wallet          @relation("TransactionWallet", fields: [walletId], references: [id], onDelete: Restrict)
  transferWallet   Wallet?         @relation("TransferDestinationWallet", fields: [transferWalletId], references: [id], onDelete: Restrict)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments      Attachment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([transferWalletId])
  @@index([categoryId])
  @@index([transactionDate])
  @@index([type])
  @@map("transactions")
}

model Attachment {
  id                   String      @id @default(uuid())
  transactionId        String
  telegramFileId       String      @db.Text
  telegramFileUniqueId String      @db.Text
  fileName             String?     @db.VarChar(255)
  mimeType             String?     @db.VarChar(100)
  fileSize             BigInt?
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt            DateTime    @default(now())

  @@index([transactionId])
  @@map("attachments")
}

model Conversation {
  id        String             @id @default(uuid())
  userId    String             @unique
  action    ConversationAction
  step      ConversationStep
  data      Json               @default("{}")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("conversations")
}

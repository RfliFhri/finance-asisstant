APP_NAME=Finance Assistant
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Untuk aplikasi serverless (Vercel), gunakan Supavisor Transaction Pooler
# dari Supabase Dashboard > Connect (port 6543). Tambahkan ?pgbouncer=true.
DATABASE_URL=

# Create this with @BotFather. Do not commit the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Required only when configuring a Telegram webhook.
TELEGRAM_WEBHOOK_URL=
